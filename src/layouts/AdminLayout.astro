---
import '../styles/global.css';
import { loadContent } from '../lib/content';
const site = await loadContent<any>('site');
const { title } = Astro.props as { title?: string };
const fullTitle = title ? `${title} · Admin · ${site.shortName}` : `Admin · ${site.shortName}`;
const pathname = Astro.url.pathname;
const isLogin = pathname === '/admin' || pathname === '/admin/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={site.logo} />
    <title>{fullTitle}</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen flex flex-col bg-wildcat-black text-white font-sans">
    <header class="border-b border-white/10 bg-wildcat-black/80 backdrop-blur">
      <div class="container-x h-16 flex items-center justify-between">
        <a href="/admin/dashboard" class="flex items-center gap-3">
          <img src={site.logo} alt="logo" class="h-9 w-9 rounded-full ring-2 ring-wildcat-orange/60" />
          <div>
            <div class="font-display tracking-wide text-base leading-none">{site.shortName}</div>
            <div class="text-[10px] uppercase tracking-[0.3em] text-wildcat-orange mt-1">Admin Console</div>
          </div>
        </a>
        <div class="flex items-center gap-3 text-sm">
          <a href="/" class="text-white/60 hover:text-white">View Site →</a>
          {!isLogin && (
            <form method="POST" action="/api/admin/logout">
              <button class="btn-ghost !py-2 !px-4 !text-xs">Sign out</button>
            </form>
          )}
        </div>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-white/10 py-4 text-center text-xs text-white/40">
      Admin console — changes save to the live site automatically.
    </footer>
  </body>
</html>
