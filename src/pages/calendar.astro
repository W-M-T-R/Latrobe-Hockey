---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { loadContent } from '../lib/content';

const cal = await loadContent<any>('calendar');
const hasPdf = !!cal.pdfHref && cal.pdfVisible !== false;
---
<BaseLayout title="Calendar">
  <PageHero eyebrow={cal.hero.eyebrow} title={cal.hero.title} subtitle={cal.hero.subtitle} />

  <section class="section">
    <div class="container-x">
      {hasPdf ? (
        <a href={cal.pdfHref} target="_blank" rel="noopener"
           class="card card-hover group flex flex-col sm:flex-row sm:items-center gap-6 !p-8 max-w-3xl">
          <span class="h-16 w-16 rounded-2xl bg-wildcat-orange/15 text-wildcat-orange flex items-center justify-center shrink-0 group-hover:bg-wildcat-orange group-hover:text-white transition">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg>
          </span>
          <div class="flex-1">
            <div class="text-xs uppercase tracking-[0.3em] text-wildcat-orange mb-1">PDF</div>
            <h2 class="font-display text-3xl tracking-wide">{cal.pdfTitle || 'Season Calendar'}</h2>
            {cal.pdfBlurb && <p class="mt-2 text-white/85 text-lg">{cal.pdfBlurb}</p>}
          </div>
          <span class="btn-primary !text-base whitespace-nowrap">Open PDF</span>
        </a>
      ) : (
        <div class="card text-center py-16 max-w-2xl mx-auto">
          <div class="font-display text-3xl mb-2">Calendar Coming Soon</div>
          <p class="text-white/80 max-w-lg mx-auto">{cal.emptyMessage}</p>
          <a href="/forms" class="btn-primary mt-6">View Forms & Tryouts</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
