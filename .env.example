# Required: shared password the secretary types in to log into /admin
ADMIN_PASSWORD=change-me-please

# Optional: separate secret for signing session cookies
# (defaults to ADMIN_PASSWORD if unset)
ADMIN_SESSION_SECRET=

# GitHub auto-commit (only needed in production)
# When set, content edits + image uploads commit to this repo,
# which triggers your hosting provider to redeploy.
# Without these set, edits write to the local filesystem (good for development).
GITHUB_TOKEN=
GITHUB_OWNER=W-M-T-R
GITHUB_REPO=Latrobe-Hockey
GITHUB_BRANCH=main
GITHUB_PATH_PREFIX=
